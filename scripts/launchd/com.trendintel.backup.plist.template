<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.trendintel.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string><string>run</string><string>--project</string><string>__PROJECT__</string>
    <string>trend-intel</string>
    <string>--log-file</string><string>__PROJECT__/data/logs/backup.log</string>
    <string>backup</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <!-- daily at 03:30 local time (America/Detroit); keeps the newest 7 snapshots -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__PROJECT__/data/logs/launchd-backup.out.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/data/logs/launchd-backup.err.log</string>
</dict>
</plist>
