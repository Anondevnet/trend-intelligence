<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.trendintel.collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string><string>run</string><string>--project</string><string>__PROJECT__</string>
    <string>trend-intel</string>
    <string>--log-file</string><string>__PROJECT__/data/logs/collect.log</string>
    <string>collect</string><string>--due</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <!-- every 15 minutes; each source runs only when its own interval has elapsed -->
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__PROJECT__/data/logs/launchd-collect.out.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/data/logs/launchd-collect.err.log</string>
</dict>
</plist>
