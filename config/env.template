# Placeholder template. Copy to .env in the project root and fill in locally:
#   cp config/env.template .env && chmod 600 .env
# NEVER commit .env. Every variable is optional; a source that needs a missing
# credential stays disabled.

# --- GitHub (raises REST limits from 60/h to 5000/h; a fine-grained token with NO scopes is enough) ---
GITHUB_TOKEN=

# --- Reddit (OAuth app-only credentials; adapter stays off without them) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Solana RPC (optional; defaults to the public mainnet endpoint) ---
SOLANA_RPC_URL=

# --- Anthropic (Stage 8; runtime API key, separate from the Claude Code login) ---
ANTHROPIC_API_KEY=
# Real Anthropic calls stay off unless this is exactly "enabled" AND models.yaml says live_calls: true.
LIQUIDMEXX_LIVE_LLM=

# --- X (Stage 10; OAuth 1.0a user context for posting) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
# Real X search reads (paid, capped by budgets.yaml) stay off unless this is exactly "enabled"
# AND sources.yaml says x.enabled: true.
LIQUIDMEXX_LIVE_X=
# Live posting stays off unless this is exactly "enabled" AND publishing.yaml says mode: "live".
LIQUIDMEXX_LIVE_POSTING=

# --- Paths (optional override; default is ./data) ---
LIQUIDMEXX_DATA_DIR=
